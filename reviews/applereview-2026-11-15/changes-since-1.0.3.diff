+        placeClosed(&waiting, force: true)
+        if subviews.isEmpty { y = spacing }
+        let bottom = open.contains(true) ? max(lanes[0].y, lanes[1].y) : y + (row.isEmpty ? 0 : placeRow(row, x: 0, y: y) + spacing)
