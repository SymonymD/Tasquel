+            ZStack {
+                Circle().stroke(track.opacity(0.45), lineWidth: lineWidth)
+                Circle()
+                    .trim(from: 0, to: min(max(progress, 0), 1))
+                    .stroke(color, style: StrokeStyle(lineWidth: lineWidth, lineCap: .round))
