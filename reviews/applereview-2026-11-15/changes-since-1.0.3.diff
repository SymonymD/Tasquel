+                let batch = Array(items.prefix(count))
+                items.removeFirst(batch.count)
+                lanes[lane].y += placeRow(batch, x: lanes[lane].x, y: lanes[lane].y) + spacing
+            }
+        }
+        while i < subviews.count {
+            if open[i] {
